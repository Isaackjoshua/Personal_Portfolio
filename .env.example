# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in what you need.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Nothing here is required for `npm run dev` to
# start — every variable has a working fallback.
# ---------------------------------------------------------------------------


# The canonical origin of the deployed site. Used for `metadataBase`, canonical
# URLs, Open Graph tags, sitemap.xml and robots.txt.
#
# No trailing slash. Leave blank locally; set it in Vercel for production.
# Falls back to https://isaackjoshua.vercel.app (see src/lib/site.ts).
#
# Required: no (recommended in production)
NEXT_PUBLIC_SITE_URL=


# API key for Resend, which delivers contact-form submissions by email.
# Create a free account at https://resend.com, then generate a key under
# Dashboard -> API Keys. Keys look like `re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx`.
#
# When this is absent the contact form still validates, rate-limits and returns
# a success response — the submission is written to the server log instead of
# being emailed. Nothing in the UI breaks.
#
# Required: no (the form degrades gracefully without it)
RESEND_API_KEY=


# The `From` address on contact-form emails. Must be an address on a domain you
# have verified in Resend, e.g. `Portfolio <hello@your-domain.com>`.
# Defaults to Resend's shared sandbox sender, `Portfolio <onboarding@resend.dev>`,
# which works without domain verification but can only deliver to the address
# that owns the Resend account.
#
# Required: no
CONTACT_FROM_EMAIL=


# Where contact-form submissions are delivered.
# Defaults to isaackjoshua23@gmail.com.
#
# Required: no
CONTACT_TO_EMAIL=
